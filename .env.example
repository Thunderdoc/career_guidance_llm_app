# Deployment environment: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Input validation bounds
MIN_INPUT_LENGTH=3
MAX_INPUT_LENGTH=10000

# Optional: enables AI explanations grounded in the O*NET taxonomy (RAG).
# Leave empty for fully offline semantic matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# ---- LLM provider factory (Phase 7) ----
# LLM_PROVIDER=openai|gemini|ollama. Unset = legacy auto behaviour:
# OpenAI when OPENAI_API_KEY is set, else Gemini when GEMINI_API_KEY is
# set, else fully offline. Every provider shares the same timeout, one
# transient retry, strict JSON schema validation and faithfulness check,
# and falls back to offline matching on any failure.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Local Ollama server (no key needed). LLM_PROVIDER=ollama selects it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30

# ---- Semantic matching blend (Phase 7) ----
# When true, MatcherV2's final score = (1-w)*hybrid + w*semantic at ONE
# seam (career_guidance/semantic.py). Measured on the golden eval with
# the TF-IDF scorer at w=0.25: Hit@5 1.0 -> 1.0, MRR 0.827 -> 0.888 —
# but default-ON broke an existing full-suite sanity gate, so the
# default is OFF (see semantic.py docstring for the full table + rule).
SEMANTIC_MATCHING_ENABLED=false
SEMANTIC_BLEND_WEIGHT=0.25
# Optional sentence-transformers model name. Only when set is the
# embedding scorer used, and it fails soft to TF-IDF on any error
# (package missing, download failure, offline). Never a hard dependency.
SEMANTIC_EMBEDDING_MODEL=

# Optional: live salary / demand data (free tier at developer.adzuna.com).
# Without these, labelled estimates are shown.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SQLite path for history & analytics.
# Render: /app/data/career_guidance.db (on the persistent disk).
DATABASE_PATH=data/career_guidance.db
# Optional (Phase 6): DATABASE_URL overrides DATABASE_PATH for the core
# store + migrations. postgres://user:pass@host:5432/db selects Postgres
# (needs: pip install -r requirements-postgres.txt); sqlite:///path.db
# also works. Leave unset for the default SQLite file. See docs/DEPLOY.md §6
# for the current per-feature-store boundary before using Postgres in prod.
DATABASE_URL=
# Optional (Phase 6): error-tracking webhook. When set, a minimal JSON
# payload (error type + request id, never bodies/PII) is POSTed on
# unhandled 500s. Unset = disabled; delivery failures are swallowed.
ERROR_WEBHOOK_URL=

# The app is private by default: every content route returns 401 without a
# signed-in session (see docs/DEPLOY.md). Set to true to re-open guest access.
PUBLIC_APP=false

# ---- Accounts & admin (optional; app works anonymously without these) ----
# Random 32+ char secret used to sign session cookies. REQUIRED in production
# (the app refuses to start without it when APP_ENV=production).
SESSION_SECRET=
# Comma-separated origins allowed to call the API cross-origin. Defaults to
# "*" (dev previews); set to the production front-end origin to lock down.
CORS_ALLOW_ORIGINS=
# Public origin of the app (needed for Google OAuth redirect + e-mailed links).
PUBLIC_URL=http://localhost:3000
# Comma-separated e-mails that get the admin role on first sign-in.
ADMIN_EMAILS=
# Google OAuth (console.cloud.google.com → Credentials → OAuth client, type "Web").
# Authorised redirect URI:  {PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for e-mail magic links (any provider: Gmail app password, SES, Resend, Brevo…).
# If empty, links are logged to the server console (and shown in the UI outside production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Firebase Authentication (preferred sign-in) ----
# Public web config (also needed by docker compose build args; for `next dev` put the
# same NEXT_PUBLIC_* values in frontend/.env.local — see frontend/.env.example).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project id from the Firebase console. Enables /api/v1/auth/firebase.
FIREBASE_PROJECT_ID=
# Optional: service-account JSON path (kept out of git under secrets/). Only needed
# for admin-side user management via Firebase; token verification works without it.
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Billing: plans, trial, Razorpay (sell-standard) ----
# Prices in INR per month. When a price is unset, the pricing page shows
# "Contact us" for that plan instead of an invented number.
BILLING_PRO_PRICE_INR=
BILLING_INSTITUTE_PRICE_INR=
# One-time free trial of Pro, in days (0 disables trials).
BILLING_TRIAL_DAYS=7
# When true (default), the roadmap PDF export requires Pro (402 for Free
# users). Set to false to restore open access for every signed-in user.
BILLING_ENFORCE_PRO=true
# Razorpay keys (dashboard: Settings -> API Keys). Until both are set,
# checkout and the webhook answer 501 and no payment is ever faked.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Phase 9 subscriptions (optional, ADDITIONAL to one-time checkout):
# Razorpay *plan* ids, created in the Razorpay dashboard (Subscriptions ->
# Plans). Until a plan id is set, subscribing for that plan answers an
# honest "subscriptions not configured" (409) — plan ids are never
# invented in code. The billing page shows the Subscribe option only
# when keys AND at least one plan id are set.
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_INSTITUTE_PLAN_ID=
