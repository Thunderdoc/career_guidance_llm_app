# Deployment environment: development | staging | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Input validation bounds
MIN_INPUT_LENGTH=3
MAX_INPUT_LENGTH=10000

# Optional: enables AI-powered suggestions. Leave empty for offline demo mode.
# Never commit a real key. Configure it in your deployment platform's secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Path of the local SQLite database used for history and analytics.
DATABASE_PATH=data/career_guidance.db
