# Frontend environment — copy to .env.local for `next dev`.
# Same values as the NEXT_PUBLIC_* entries in the repo-root .env.example.
# API base: local backend runs on :8000 (see Makefile `api` target).
# In production this is the Render backend URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Public origin of this front end (Phase 6 SEO: metadataBase, sitemap,
# robots, Open Graph URLs). Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config (public values; same as repo-root .env.example).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
